# Separate BotFather Telegram bot token, NOT your existing public StudentAssistantBot token
BOT_TOKEN=your_separate_adult_bot_token
WEBHOOK_SECRET=a_random_very_long_secret
GEMINI_API_KEY=your_private_google_ai_studio_key
# Do NOT switch on until restricted deployment and adult eligibility review are complete
GEMINI_ENABLED=false
# Verified adult Telegram accounts only; checking an ID alone is not age verification
GEMINI_ADULT_USER_IDS=123456789
GEMINI_DAILY_LIMIT=8
GEMINI_SHARED_DAILY_LIMIT=100
GEMINI_SHARED_MINUTE_LIMIT=8
# Render sets RENDER_EXTERNAL_URL automatically
